}

.commission-item {
  border-bottom: 1px solid var(--border);
  padding: 1.25rem 0;
}

.commission-item:first-child {
  border-top: 1px solid var(--border);
}

.commission-item dt {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--accent);
  margin-bottom: 0.4rem;
}

.commission-item dd {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0;
}

.commission-cta {
  margin-top: 2.5rem;
  text-align: center;
}

/* 笏笏 Commission CTA section (index.html) 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏 */
#commission-cta {
  border-top: 1px solid var(--border);
}

/* 笏笏 Portfolio Page Styles 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏 */
